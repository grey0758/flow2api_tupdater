ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG WORKER_UID

# Layer the login entry and challenge-classification fixes on each distinct
# production slot image. Preserve its project validator and browser runtime.
USER 0
COPY token_updater/google_login_automation.py /app/token_updater/google_login_automation.py
COPY token_updater/login_worker.py /app/token_updater/login_worker.py
RUN python -m py_compile /app/token_updater/google_login_automation.py /app/token_updater/login_worker.py
USER ${WORKER_UID}:12000
