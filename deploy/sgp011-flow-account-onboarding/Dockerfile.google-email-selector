ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG WORKER_UID

# Preserve every slot's existing validator, extension mount, and browser
# runtime. This layer changes only Google's current email field selector.
USER 0
COPY token_updater/google_login_automation.py /app/token_updater/google_login_automation.py
RUN python -m py_compile /app/token_updater/google_login_automation.py
USER ${WORKER_UID}:12000
