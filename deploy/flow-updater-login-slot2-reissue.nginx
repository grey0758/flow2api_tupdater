# Temporary Profile15/slot2 invitation plane. The sidecar checks a one-time
# capability and scoped cookie. No administration route is proxied here.
location = /login-slot2-reissue {
    auth_basic off;
    return 307 /login-slot2-reissue/;
}

location = /login-slot2-reissue/vnc/websockify {
    auth_basic off;
    proxy_pass http://unix:/run/flow2api-login-slots/sidecar2-reissue/sidecar.sock:;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
    proxy_buffering off;
}

location ^~ /login-slot2-reissue/ {
    auth_basic off;
    proxy_pass http://unix:/run/flow2api-login-slots/sidecar2-reissue/sidecar.sock:;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_connect_timeout 15s;
    proxy_send_timeout 3600s;
    proxy_read_timeout 3600s;
    proxy_request_buffering off;
    proxy_buffering off;
    client_max_body_size 64k;
}
