# Existing control-plane WebSocket. Inherit server-level Basic Auth.
location = /login-slots/vnc/websockify {
    proxy_pass http://127.0.0.1:18083;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
    proxy_buffering off;
}

# Slot 3 is a login-only UDS sidecar. It has no TCP listener, scheduler,
# Updater database, or application network. Admin routes are deliberately
# outside this public prefix and therefore are not forwarded here.
location = /login-slot3 {
    return 307 /login-slot3/;
}

location = /login-slot3/vnc/websockify {
    proxy_pass http://unix:/run/flow2api-login-slots/sidecar3/sidecar.sock:;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
    proxy_buffering off;
}

location ^~ /login-slot3/ {
    proxy_pass http://unix:/run/flow2api-login-slots/sidecar3/sidecar.sock:;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_connect_timeout 15s;
    proxy_send_timeout 3600s;
    proxy_read_timeout 3600s;
    proxy_request_buffering off;
    proxy_buffering off;
    client_max_body_size 64k;
}
