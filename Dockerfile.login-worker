ARG BASE_IMAGE=flow2api-token-updater-control:local
FROM ${BASE_IMAGE} AS worker-filesystem

# The control image declares /app/{data,logs,profiles} as VOLUMEs.  Copy its
# filesystem into a fresh image stage so workers do not inherit three extra
# anonymous persistent mounts.  No application data is included in the base.
FROM scratch
COPY --from=worker-filesystem / /
ARG WORKER_UID=11001

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /app

RUN (getent group 12000 >/dev/null || groupadd --gid 12000 login-slots) \
    && (getent passwd 11001 >/dev/null || useradd --uid 11001 --gid 12000 --no-create-home --shell /usr/sbin/nologin login-slot1) \
    && (getent passwd 11002 >/dev/null || useradd --uid 11002 --gid 12000 --no-create-home --shell /usr/sbin/nologin login-slot2) \
    && python -c 'import cryptography' \
    && chmod a+rx /root /root/.cache \
    && chmod -R a+rX /root/.cache/ms-playwright

COPY token_updater/ /app/token_updater/

RUN mkdir -p /slot/profile /control /egress \
    && chown ${WORKER_UID}:12000 /slot/profile \
    && chmod 0700 /slot/profile \
    && chown ${WORKER_UID}:12000 /control /egress \
    && chmod 0770 /control /egress

USER ${WORKER_UID}:12000

CMD ["python", "-m", "token_updater.login_worker"]
